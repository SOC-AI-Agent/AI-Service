meta {
  name: LLM probe - show the wiring
  type: http
  seq: 3
}

post {
  url: {{ai}}/llm-probe
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rendered_prompt": "Say OK and nothing else."
  }
}

tests {
  test("responds 2xx", function() {
    expect(res.getStatus()).to.be.within(200, 300);
  });
  test("shows what was sent", function() {
    expect(res.getBody().request).to.have.property("url");
  });
}

docs {
  Same call as Analyze, but returns the request that was sent and the raw stream lines that came back. Use it when the LLM server changes shape and the answer parses empty: the raw lines say which key the text is under. Never echoes the Authorization header.
}
