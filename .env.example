# soc-ai-service — only the settings this service reads.
#
# Local run: `cp .env.example .env` and set AI_SERVICE_AUTH_TOKEN. Deploy: the
# pipeline builds .env from THIS file plus the GitLab CI variables — a key has to
# be listed here to be picked up, and one with no CI variable keeps the value
# written here. So no real secret goes in this file.

# ========== ACCESS ==========
# Bearer token the backend presents on every route except /health. Must match
# AI_SERVICE_AUTH_TOKEN in Backend/.env byte for byte. Unset = refuses to start.
# Generate: openssl rand -hex 32
AI_SERVICE_AUTH_TOKEN=

# ========== AGENT PLATFORM ==========
# soc-ai does not talk to Ollama; it asks the agent platform to run a named
# agent and reads the answer off the stream. That platform is Agent-Server
# (DALL-M, ../Agent-Server) — its own repo, own Postgres, own docker compose —
# not soc-network, so this is a URL rather than a container name, the same way
# Splunk/ThreatQ/Confluence are reached. These settings are still a generic
# adapter (nothing elsewhere assumes this exact shape), just defaulted to
# Agent-Server's actual contract now instead of a placeholder.
#
# host.docker.internal reaches a container's published port from another
# compose project on the same machine (Docker Desktop out of the box; on Linux
# add extra_hosts: ["host.docker.internal:host-gateway"] to this service).
# Point this at Agent-Server's real host when it runs elsewhere.
LLM_SERVER_URL=http://host.docker.internal:8001
# {agent} is substituted with the slug. Agent-Server: POST /v1/agents/{slug}/chat
# (server/app/routers/agent_invoke.py). A server that takes the agent in the
# body instead can use a static path here and name the field in LLM_AGENT_FIELD.
LLM_RUN_PATH=/v1/agents/{agent}/chat
# soc-suggest: the agent that reads an alert with its context and writes the suggestion,
# with no tools. The backend names its agent on every call; this is only for a caller
# that does not. Create this slug (and soc-requirements, soc-conclude) in
# Agent-Server's admin UI or its POST /restful/agents — nothing here creates them.
LLM_DEFAULT_AGENT=soc-suggest
# Body field names — the part that differs most between implementations.
# Agent-Server's AgentChatRequest reads the alert text as "message".
LLM_INPUT_FIELD=message
LLM_AGENT_FIELD=
# Extra body fields as JSON, e.g. {"stream": true}. Left blank: Agent-Server's
# own default (stream: true) is fine, and LLM_STREAM_MODE=auto follows whichever
# content type it answers with.
LLM_EXTRA_BODY=
# auto = follow the response content type; always = treat the body as a stream
# whatever it says; never = expect one JSON object.
LLM_STREAM_MODE=auto
# If their service wants a bearer token / other headers (JSON). Agent-Server's
# /v1/agents/... takes none yet (see its readme.md, "Known limitations") — leave
# blank; set this the day it does, without anything else here changing.
LLM_AUTH_TOKEN=
LLM_EXTRA_HEADERS=
# An agent run makes several model and tool calls.
LLM_TIMEOUT=1860
# What this service's own /health checks. Agent-Server has no /health — its
# root answers {"status": "ok"} (server/app/main.py).
LLM_HEALTH_PATH=/

# ========== PLAYBOOK INDEX ==========
# The backend reads the playbook pages out of Confluence (through the connector)
# and sends them here; this service extracts the Page Properties fields, embeds
# them, and answers "which playbook covers this alert" — by name, then spelling,
# then meaning. Only fields whose text changed are embedded again.
#
# The playbooks: one JSON file on the playbook-index volume. Their vectors are in
# Qdrant (below).
PLAYBOOK_INDEX_PATH=/data/playbook-index.json
# Tier 2: a renamed detection still finds its playbook by spelling (0-1).
PLAYBOOK_FUZZY_CUTOFF=0.85
# Tier 3: matching by meaning. false = tiers 1 and 2 only, and no model is loaded.
PLAYBOOK_SEMANTIC=true
# A meaning match must reach this cosine similarity AND lead the next playbook
# by this much. Measured with bge-small on six sample playbooks: 0.75/0.05 took
# 8 of 12 renamed detections and 0 of 14 unrelated ones. Recalibrate on the real
# pages before relying on it; a wrong playbook is worse than none.
PLAYBOOK_SEMANTIC_MIN_SCORE=0.75
PLAYBOOK_SEMANTIC_MIN_MARGIN=0.05
# The embedding model, in this process on CPU — never through Ollama, which
# holds one model at a time and would evict the agents' 7B. It is baked into
# the image at build time; changing it means rebuilding with
# --build-arg EMBED_MODEL=<the same name>.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ========== VECTOR DATABASE (Qdrant) ==========
# One point per playbook description, true/false condition and runbook step,
# searched by POST /playbooks/match (tier 3) and POST /playbooks/search.
# Empty: Qdrant runs embedded in this process, its files at QDRANT_PATH on the
# playbook-index volume — what the stacks under ../Backend/deploy use, with no
# extra container. This repo's docker-compose.yml runs a Qdrant server
# (soc-qdrant) and points soc-ai at it whenever this is left empty.
QDRANT_URL=
# Only when the server has one set (QDRANT__SERVICE__API_KEY on the container).
QDRANT_API_KEY=
QDRANT_PATH=/data/qdrant
QDRANT_TIMEOUT_S=10

# ========== APP ==========
APP_NAME=SOC AI Suggestion
APP_ENV=production
DEBUG=false
