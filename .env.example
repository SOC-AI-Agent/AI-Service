# soc-ai-service — only the settings this service reads.
#
# Local run: `cp .env.example .env` and set AI_SERVICE_AUTH_TOKEN. Deploy: the
# pipeline builds .env from THIS file plus the GitLab CI variables — a key has to
# be listed here to be picked up, and one with no CI variable keeps the value
# written here. So no real secret goes in this file.

# ========== ACCESS ==========
# Bearer token the backend presents on every route except /health. Must match
# AI_SERVICE_AUTH_TOKEN in Backend/.env byte for byte. Unset = refuses to start.
# Generate: openssl rand -hex 32
AI_SERVICE_AUTH_TOKEN=

# ========== LLM SERVER (agent platform) ==========
# soc-ai does not talk to Ollama; it asks the LLM server to run an agent and
# reads the answer off the stream. That server is another team's, so nothing in
# soc-ai assumes its shape — these settings are how it adapts.
LLM_SERVER_URL=http://soc-llm-server:8400
# {agent} is substituted. A server that takes the agent in the body instead can
# use a static path here and name the body field in LLM_AGENT_FIELD.
LLM_RUN_PATH=/agents/{agent}/run
# soc-suggest: the agent that reads an alert with its context and writes the suggestion,
# with no tools. The backend names its agent on every call; this is only for a caller
# that does not.
LLM_DEFAULT_AGENT=soc-suggest
# Body field names — the part that differs most between implementations.
LLM_INPUT_FIELD=input
LLM_AGENT_FIELD=
# Extra body fields as JSON, e.g. {"stream": true}
LLM_EXTRA_BODY=
# auto = follow the response content type; always = treat the body as a stream
# whatever it says; never = expect one JSON object.
LLM_STREAM_MODE=auto
# If their service wants a bearer token / other headers (JSON).
LLM_AUTH_TOKEN=
LLM_EXTRA_HEADERS=
# An agent run makes several model and tool calls.
LLM_TIMEOUT=1860

# ========== PLAYBOOK INDEX ==========
# The backend reads the playbook pages out of Confluence (through the connector)
# and sends them here; this service extracts the Page Properties fields, embeds
# them, and answers "which playbook covers this alert" — by name, then spelling,
# then meaning. Only fields whose text changed are embedded again.
#
# One file on the playbook-index volume.
PLAYBOOK_INDEX_PATH=/data/playbook-index.npz
# Tier 2: a renamed detection still finds its playbook by spelling (0-1).
PLAYBOOK_FUZZY_CUTOFF=0.85
# Tier 3: matching by meaning. false = tiers 1 and 2 only, and no model is loaded.
PLAYBOOK_SEMANTIC=true
# A meaning match must reach this cosine similarity AND lead the next playbook
# by this much. Measured with bge-small on six sample playbooks: 0.75/0.05 took
# 8 of 12 renamed detections and 0 of 14 unrelated ones. Recalibrate on the real
# pages before relying on it; a wrong playbook is worse than none.
PLAYBOOK_SEMANTIC_MIN_SCORE=0.75
PLAYBOOK_SEMANTIC_MIN_MARGIN=0.05
# The embedding model, in this process on CPU — never through Ollama, which
# holds one model at a time and would evict the agents' 7B. It is baked into
# the image at build time; changing it means rebuilding with
# --build-arg EMBED_MODEL=<the same name>.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ========== APP ==========
APP_NAME=SOC AI Suggestion
APP_ENV=production
DEBUG=false
